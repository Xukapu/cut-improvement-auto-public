# Set both passwords before running Docker Compose. Use different values.
POSTGRES_PASSWORD=
DB_PASSWORD=

DB_NAME=cut_improvement_auto_prod
DB_USER=cut_app
# For local Python, use the host where PostgreSQL is listening.
DB_HOST=127.0.0.1

ENVIRONMENT=production
CUT_SITE=sto.example.com
ALLOWED_HOSTS='["sto.example.com","127.0.0.1","localhost"]'
WORKSHOP_TIMEZONE=Asia/Novosibirsk

# Keep disabled during database restore and initial checks.
MAX_DISPATCH_MODE=disabled
# MAX_BOT_TOKEN=
# MAX_TEST_CLIENT_NUMBER=
